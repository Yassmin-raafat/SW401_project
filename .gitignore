cat > .gitignore << 'EOF'
# Ignore Phase 2 large input files
phase2/data/input_25MB.txt
phase2/data/input_50MB.txt
phase2/data/input_100MB.txt
phase2/data/input_200MB.txt

# Ignore any very large text inputs
**/very_huge_input.txt

# Ignore all txt files (to avoid uploading huge inputs)
*.txt

# BUT keep the small input file needed by the project
!phase2/data/input.txt
!data/input.txt

# Ignore compiled binaries
*.out
*.exe
*.o
*.a
*.so
*.class
*.pyc

# Ignore MPI compiled binaries
phase2/src/wc_mpi
phase2/src/bandwidth_test
phase2/src/latency_test

phase2/wc_mpi
phase2/bandwidth_test
phase2/latency_test

# Logs
*.log

# VSCode settings
.vscode/
EOF
mpic++ wc_mpi.cpp -o wc_mpi
mpirun --allow-run-as-root -np 2 ./wc_mpi ../data/input.txt
mpic++ latency_test.cpp -o latency_test
mpirun --allow-run-as-root -np 2 ./latency_test
mpic++ bandwidth_test.cpp -o bandwidth_test
mpirun --allow-run-as-root -np 2 ./bandwidth_test
# Python / venv
.venv/
venv/
__pycache__/
*.pyc

# Logs / outputs
phase3/logs/
*.log

# Spark checkpoints (لو عندك)
checkpoint/
**/checkpoint/

# OS / IDE
.DS_Store
.vscode/
.idea/
